/**
 * Nodes page redesigned for 200+ video files.
 * Primary: Search + grouped video grid (by artist from filename patterns).
 * Secondary: "Similar videos" mini-panel when a video is long-pressed.
 */
@Composable
fun NodesScreen(
    allFiles: List<MediaFile>,
    playHistory: List<PlayHistoryEntry>,
    currentPath: String?,
    contentPadding: PaddingValues,
    onLibrary: () -> Unit,
    onPlay: (MediaFile) -> Unit,
    onLoadThumbnail: suspend (MediaFile) -> android.graphics.Bitmap?,
    language: AppLanguage
) {
    val scrollState = rememberScrollState()
    var query by remember { mutableStateOf("") }
    var selectedFile by remember { mutableStateOf<MediaFile?>(null) }
    var showSimilar by remember { mutableStateOf(false) }

    // Extract artist from filename patterns like 【artist】title
    val artistMap = remember(allFiles) {
        allFiles
            .filter { it.kind == MediaKind.VIDEO }
            .groupBy { extractArtist(it.name) }
            .mapValues { it.value.sortedBy { it.name } }
            .toSortedMap()
    }

    // Recent videos from play history (last 10)
    val recentVideos = remember(playHistory, allFiles) {
        val fileMap = allFiles.associateBy { it.path }
        playHistory
            .mapNotNull { fileMap[it.path] }
            .distinctBy { it.path }
            .take(10)
    }

    // Filtered files based on query
    val filteredGroups = remember(artistMap, query) {
        if (query.isBlank()) artistMap
        else artistMap.mapValues { it.value.filter { it.name.contains(query, ignoreCase = true) } }
            .filterValues { it.isNotEmpty() }
    }

    val hasResults = filteredGroups.values.any { it.isNotEmpty() } || recentVideos.any { it.name.contains(query, ignoreCase = true) }

    Column(
        Modifier
            .fillMaxSize()
            .background(MaterialTheme.colorScheme.background)
            .verticalScroll(scrollState)
            .padding(contentPadding)
            .consumeWindowInsets(contentPadding)
            .statusBarsPadding()
    ) {
        // Header
        Row(
            Modifier.fillMaxWidth().padding(horizontal = 12.dp),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(uiText(language, "Nodes", "Nodes"), style = MaterialTheme.typography.titleLarge, modifier = Modifier.padding(vertical = 12.dp))
            TextButton(onClick = onLibrary) { Text(uiText(language, "← Library", "← Library")) }
        }

        // Search bar
                LiquidMetalSurface(
                    modifier = Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 6.dp),
                    shape = FoundationRoundedCornerShape(18.dp),
                ) {
                    OutlinedTextField(
                        value = query,
                        onValueChange = { query = it },
                        modifier = Modifier.fillMaxWidth(),
                        shape = FoundationRoundedCornerShape(18.dp),
                        singleLine = true,
                        keyboardOptions = KeyboardOptions.Default,
                        leadingIcon = { Icon(Icons.Rounded.Search, null) },
                        trailingIcon = if (query.isNotEmpty()) {
                            { IconButton(onClick = { query = "" }) { Icon(Icons.Rounded.Clear, uiText(language, "Clear filter", "清除篩選")) } }
                        } else null,
                        placeholder = { Text(uiText(language, "Filter videos…", "篩選影片…")) },
                                        colors = OutlinedTextFieldDefaults.textFieldColors(
                            focusedIndicatorColor = Color.Transparent,
                            unfocusedIndicatorColor = Color.Transparent,
                            disabledIndicatorColor = Color.Transparent,
                        ),
                    )
                }

        // Results count
        if (query.isNotBlank()) {
            Text(
                if (hasResults) uiText(language, "Showing ${filteredGroups.values.sumOf { it.size } + recentVideos.count { it.name.contains(query, ignoreCase = true) }} videos", "顯示 ${filteredGroups.values.sumOf { it.size } + recentVideos.count { it.name.contains(query, ignoreCase = true) }} 部影片")
                else uiText(language, "No videos match", "無符合的影片"),
                style = MaterialTheme.typography.labelSmall,
                color = MaterialTheme.colorScheme.onSurfaceVariant,
                modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
            )
        }

        // Recent videos section
        if (recentVideos.isNotEmpty() && query.isBlank()) {
            SectionHeader(
                title = uiText(language, "Recent", "最近播放"),
                count = recentVideos.size,
                icon = Icons.Rounded.History,
                language = language
            )
            VideoGridRow(videos = recentVideos, onPlay = onPlay, onLoadThumbnail = onLoadThumbnail, currentPath = currentPath, selectedFile = selectedFile, onSelect = { selectedFile = it; showSimilar = true })
        }

        // Artist groups
        filteredGroups.forEach { (artist, videos) ->
            if (videos.isNotEmpty()) {
                SectionHeader(
                    title = if (artist.isBlank()) uiText(language, "Other", "其他") else artist,
                    count = videos.size,
                    icon = Icons.Rounded.MusicNote,
                    language = language
                )
                VideoGridRow(videos = videos, onPlay = onPlay, onLoadThumbnail = onLoadThumbnail, currentPath = currentPath, selectedFile = selectedFile, onSelect = { selectedFile = it; showSimilar = true })
            }
        }

        // Empty state
                if (!hasResults && recentVideos.isEmpty() && query.isBlank()) {
                    Text(
                        uiText(language, "No videos found. Add media in Download, then refresh Library.", "找不到影片。請在 Download 新增媒體，然後重新掃描音樂庫。"),
                        modifier = Modifier.padding(16.dp).fillMaxWidth(),
                        textAlign = TextAlign.Center,
                        color = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                }

        // Similar videos panel
        if (showSimilar && selectedFile != null) {
            SimilarVideosPanel(
                selectedFile = selectedFile!!,
                allFiles = allFiles,
                onPlay = onPlay,
                onLoadThumbnail = onLoadThumbnail,
                onClose = { showSimilar = false; selectedFile = null },
                language = language
            )
        }
    }
}

@Composable
private fun SectionHeader(title: String, count: Int, icon: androidx.compose.material.icons.rounded.Icon, language: AppLanguage) {
    Row(
        Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 8.dp),
        horizontalArrangement = Arrangement.SpaceBetween,
        verticalAlignment = Alignment.CenterVertically
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Icon(icon, null, tint = MaterialTheme.colorScheme.primary, modifier = Modifier.size(20.dp).padding(end = 8.dp))
            Text(title, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Bold)
            Text(" ($count)", style = MaterialTheme.typography.labelLarge, color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
    }
}

@Composable
private fun VideoGridRow(
    videos: List<MediaFile>,
    onPlay: (MediaFile) -> Unit,
    onLoadThumbnail: suspend (MediaFile) -> android.graphics.Bitmap?,
    currentPath: String?,
    selectedFile: MediaFile?,
    onSelect: (MediaFile) -> Unit
) {
    LazyVerticalGrid(
        columns = GridCells.Fixed(3),
        contentPadding = PaddingValues(horizontal = 12.dp, vertical = 4.dp),
        verticalArrangement = Arrangement.spacedBy(8.dp),
        horizontalArrangement = Arrangement.spacedBy(8.dp),
        modifier = Modifier.fillMaxWidth()
    ) {
        items(videos) { video ->
            VideoThumbnailCard(
                video = video,
                isPlaying = video.path == currentPath,
                isSelected = video.path == selectedFile?.path,
                onClick = { onPlay(video) },
                onLongClick = { onSelect(video) },
                onLoadThumbnail = onLoadThumbnail,
            )
        }
    }
}

@Composable
private fun VideoThumbnailCard(
    video: MediaFile,
    isPlaying: Boolean,
    isSelected: Boolean,
    onClick: () -> Unit,
    onLongClick: () -> Unit,
    onLoadThumbnail: suspend (MediaFile) -> android.graphics.Bitmap?
) {
    val thumbnail by produceState<androidx.compose.ui.graphics.ImageBitmap?>(null, video, onLoadThumbnail) {
        val bitmap = onLoadThumbnail(video)
        if (bitmap != null) value = bitmap.asImageBitmap()
    }

    val name = video.name.substringBeforeLast('.').take(32)

    Card(
            modifier = Modifier.fillMaxWidth(),
            onClick = onClick,
            onLongClick = onLongClick,
            colors = CardDefaults.cardColors(
                containerColor = when {
                    isPlaying -> MaterialTheme.colorScheme.primaryContainer
                    isSelected -> MaterialTheme.colorScheme.secondaryContainer
                    else -> MaterialTheme.colorScheme.surfaceContainerLow
                }
            ),
            shape = GraphicsRoundedCornerShape(12.dp),
            border = if (isPlaying) BorderStroke(2.dp, MaterialTheme.colorScheme.primary) else BorderStroke(0.dp, Color.Transparent)
        ) {
            Column {
                // Thumbnail
                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .aspectRatio(16f / 9f)
                        .clip(GraphicsRoundedCornerShape(topStart = 12.dp, topEnd = 12.dp))
                ) {
                    val thumb = thumbnail
                    if (thumb != null) {
                        Image(bitmap = thumb, contentDescription = null, contentScale = ContentScale.Crop, modifier = Modifier.fillMaxSize())
                    } else {
                        Box(
                            modifier = Modifier.fillMaxSize(),
                            contentAlignment = Alignment.Center
                        ) {
                            Icon(Icons.Rounded.Videocam, null, tint = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.size(32.dp))
                        }
                    }
                    if (isPlaying) {
                        Box(
                            modifier = Modifier.align(Alignment.TopEnd).padding(8.dp),
                            contentAlignment = Alignment.Center
                        ) {
                            Icon(Icons.Rounded.PlayCircleFilled, null, tint = MaterialTheme.colorScheme.primary, modifier = Modifier.size(24.dp).background(MaterialTheme.colorScheme.surface, CircleShape))
                        }
                    }
                }
                // Title
                Text(
                    text = name,
                    maxLines = 2,
                    overflow = TextOverflow.Ellipsis,
                    style = MaterialTheme.typography.labelSmall,
                    modifier = Modifier.padding(8.dp, 4.dp, 8.dp, 8.dp).fillMaxWidth()
                )
            }
        }
}

@Composable
private fun SimilarVideosPanel(
    selectedFile: MediaFile,
    allFiles: List<MediaFile>,
    onPlay: (MediaFile) -> Unit,
    onLoadThumbnail: suspend (MediaFile) -> android.graphics.Bitmap?,
    onClose: () -> Unit,
    language: AppLanguage
) {
    // Build similar videos using filename token Jaccard similarity
    val similar by remember(selectedFile, allFiles) {
        derivedStateOf {
            val currentName = selectedFile.name.substringBeforeLast('.').lowercase()
            val tokens = currentName.split("[\\p{Punct}\\s]+".toRegex()).filter { it.isNotBlank() }.toSet()
            allFiles
                .filter { it.path != selectedFile.path && it.kind == MediaKind.VIDEO }
                .mapNotNull { file ->
                    val otherName = file.name.substringBeforeLast('.').lowercase()
                    val otherTokens = otherName.split("[\\p{Punct}\\s]+".toRegex()).filter { it.isNotBlank() }.toSet()
                    val intersection = tokens.intersect(otherTokens).size
                    val union = tokens.union(otherTokens).size
                    if (union > 0) file to (intersection.toFloat() / union) else null
                }
                .filter { it.second > 0.1f }
                .sortedByDescending { it.second }
                .take(12)
                .map { it.first }
        }
    }

    Card(
            modifier = Modifier
                .fillMaxWidth()
                .padding(12.dp)
                .background(MaterialTheme.colorScheme.surfaceContainerHighest)
        ) {
            Column(modifier = Modifier.padding(12.dp)) {
                Row(
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Icon(Icons.Rounded.Hub, null, tint = MaterialTheme.colorScheme.primary, modifier = Modifier.size(20.dp).padding(end = 8.dp))
                        Text(uiText(language, "Similar to \"${selectedFile.name.substringBeforeLast('.').take(30)}\"", "相似影片"), style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.Bold)
                    }
                    IconButton(onClick = onClose) { Icon(Icons.Rounded.Close, null) }
                }
                if (similar.isEmpty()) {
                    Text(uiText(language, "No similar videos found", "找不到相似影片"), style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.padding(vertical = 16.dp).fillMaxWidth())
                } else {
                    LazyVerticalGrid(
                        columns = GridCells.Fixed(4),
                        contentPadding = PaddingValues(0.dp),
                        verticalArrangement = Arrangement.spacedBy(8.dp),
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        items(similar) { video ->
                            SimilarVideoCard(video = video, onPlay = onPlay, onLoadThumbnail = onLoadThumbnail)
                        }
                    }
                }
            }
        }
    }

@Composable
private fun SimilarVideoCard(
    video: MediaFile,
    onPlay: (MediaFile) -> Unit,
    onLoadThumbnail: suspend (MediaFile) -> Bitmap?
) {
    val thumbnail by produceState<ImageBitmap?>(null, video, onLoadThumbnail) {
        val bitmap = onLoadThumbnail(video)
        if (bitmap != null) value = bitmap.asImageBitmap()
    }

    val name = video.name.substringBeforeLast('.').take(24)

    Card(
        modifier = Modifier.fillMaxWidth(),
        onClick = { onPlay(video) },
        shape = GraphicsRoundedCornerShape(8.dp),
    ) {
        Column {
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .aspectRatio(16f / 9f)
                    .clip(GraphicsRoundedCornerShape(topStart = 8.dp, topEnd = 8.dp))
            ) {
                val thumb = thumbnail
                if (thumb != null) {
                    Image(bitmap = thumb, contentDescription = null, contentScale = ContentScale.Crop, modifier = Modifier.fillMaxSize())
                } else {
                    Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                        Icon(Icons.Rounded.Videocam, null, tint = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.size(20.dp))
                    }
                }
            }
            Text(text = name, maxLines = 1, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.labelSmall, modifier = Modifier.padding(6.dp, 4.dp, 6.dp, 6.dp).fillMaxWidth())
        }
    }
}

/**
 * Extract artist from filename patterns like 【artist】title or artist - title
 */
private fun extractArtist(filename: String): String {
    val name = filename.substringBeforeLast('.')
    // Pattern: 【artist】title
    val bracketMatch = "\\【([^】]+)\\】".toRegex().find(name)
    if (bracketMatch != null) return bracketMatch.groupValues[1]
    // Pattern: artist - title
    val dashParts = name.split(" - ", limit = 2)
    if (dashParts.size == 2 && dashParts[0].length < 40) return dashParts[0]
    return ""
}
